use tola get-site

const generated_header = '// Generated by tools/export-reference.nu.'

def help-page [tola: string, language: string, target: string] {
  let data = (do --capture-errors { ^$tola help --lang $language --format json $target })
  if $target == "tola-help://packages/address" {
    # Match the file route used in the site's routing guide.
    $data | str replace --all 'manual.pdf' 'sitemap.xml'
  } else {
    $data
  } | from json
}

def save-if-changed [file: path]: string -> nothing {
  let content = $in
  if ($file | path exists) and (open --raw $file) == $content { return }
  $content | save --raw --force $file
}

def write-reference [file: path, language: string, page: record] {
  let key = ($page.key | to json --raw)
  let locale = ($language | to json --raw)
  [
    $generated_header
    '#import "@tola/source:0.0.0": tola-meta'
    '#import "@tola/site:0.0.0": project-path'
    '#import project-path("theme/components/content/reference-data.typ"): reference-metadata'
    ('#let data = json(project-path("generated/reference.json")).pages.at(' + $locale + ')')
    ('#let entry = data.at(' + $key + ')')
    $"#tola-meta\(reference-metadata\(entry, order: ($page.order)))"
    # Page discovery needs the declaration before loading the docs tree.
    '#import "@tola-modules/docs:0.0.0": reference-page'
    '#title()'
    '#reference-page(entry, data)'
    ''
  ] | str join "\n" | save-if-changed $file
}

def export-locale [tola: string, language: string, reference: path] {
  let groups = {config: config, package: packages, scripts: scripts}
  let pages = ($groups | columns | each {|group|
    let index = (help-page $tola $language $group)
    let entries = ($index.entries | enumerate | each {|entry|
      let page = (help-page $tola $language $entry.item.target)
      let key = ($page.page | str replace 'tola-help://' '')
      {
        key: $key
        data: $page
        order: ($entry.index + 1)
        file: ($reference | path join $"($key).typ")
      }
    })
    # The package and script indexes are authored by hand.
    if $group == "config" {
      $entries | prepend {
        key: config
        data: $index
        order: 5
        file: ($reference | path join config index.typ)
      }
    } else { $entries }
  } | flatten)
  let files = ($pages | get file)
  for page in $pages {
    mkdir ($page.file | path dirname)
    write-reference $page.file $language $page
  }
  for group in ($groups | values) {
    for file in (glob ($reference | path join $group '**' '*.typ') --no-dir) {
      if ($file not-in $files) and ((open --raw $file) | str starts-with $generated_header) {
        rm $file
      }
    }
  }
  $pages | reduce --fold {} {|page, data| $data | insert $page.key $page.data}
}

def main [] {
  let tola = $env.TOLA_EXECUTABLE
  let site = (get-site)
  let generated = ($site.root | path join generated)
  mkdir $generated
  let pages = {
    en: (export-locale $tola en ($site.content-root | path join en docs reference))
    zh: (export-locale $tola zh ($site.content-root | path join zh-hans docs reference))
  }
  let version = (^$tola --version | lines | first)
  {version: $version, pages: $pages} | to json --raw | save-if-changed ($generated | path join reference.json)
}
